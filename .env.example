# ==============================================================================
# ARX IT CLUB — Environment Configuration Reference (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values marked with <angle-brackets>.
# 3. NEVER commit your actual .env file to version control.
#
# KEY FORMATTING RULES:
#   - Simple alphanumeric values: NO quotes needed  (e.g. PORT=3000)
#   - Values with spaces or special chars (!@#$%^&*): WRAP IN DOUBLE QUOTES
#     e.g. INITIAL_PRESIDENT_PASSWORD="My$ecure!Pass#2026"
#   - Do NOT use single quotes — Node.js dotenv does not parse them correctly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE PROVIDER  ('mongodb' | 'neon' | 'local')
# ------------------------------------------------------------------------------
# ARX IT CLUB now uses MongoDB as the primary database backend.
#
# RECOMMENDED: 'mongodb' - Production-ready cloud database via MongoDB Atlas
# ALTERNATIVE: 'neon'    - PostgreSQL via Neon (legacy fallback)
# DEVELOPMENT: 'local'   - JSON file storage (development/testing only)
DATABASE_PROVIDER=mongodb

# MongoDB Atlas Configuration (REQUIRED when DATABASE_PROVIDER=mongodb)
# Get your connection string from: https://cloud.mongodb.com/
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/arx_it_club?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<db>?retryWrites=true&w=majority

# Neon PostgreSQL (Optional - only needed when DATABASE_PROVIDER=neon)
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-character-hex-string>

# ------------------------------------------------------------------------------
# 4. ROLE-BASED ACCESS CONTROL — Initial Credentials
#
# ROLE HIERARCHY:
#   PRESIDENTIAL_ADMIN (role: 'president')  — global access
#   LOWER_ADMIN        (role: 'lower_admin') — scoped to assigned courses/areas
#   TEACHER            (role: 'teacher')    — scoped to assigned courses
#   STUDENT            (role: 'member')     — own data only
#
# These are FIRST-RUN BOOTSTRAP ONLY. After the first run, passwords are
# stored as PBKDF2 hashes in the database and .env values are ignored.
# WRAP complex passwords in double quotes to avoid parsing errors!
# ------------------------------------------------------------------------------
INITIAL_PRESIDENT_USERNAME=<presidential-admin-username>
INITIAL_PRESIDENT_PASSWORD="<YourStr0ng!Pres#Pass2026>"

INITIAL_ADMIN_USERNAME=<lower-admin-username>
INITIAL_ADMIN_PASSWORD="<YourStr0ng!Admin#Pass2026>"

# ------------------------------------------------------------------------------
# 5. 2FA — GMAIL SMTP CONFIGURATION
#
# HOW TO GET A GMAIL APP PASSWORD (required — do NOT use your real password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. App name: "ARX IT Club Server" → click Generate
#   4. Copy the 16-character code → paste as SMTP_PASS below (keep the quotes)
#
# Port 465 + SMTP_SECURE=true  → SSL (recommended, most reliable)
# Port 587 + SMTP_SECURE=false → STARTTLS (alternative)
#
# EMAIL_FROM controls the display name shown in recipients' email clients.
# Format: "Display Name" <address@gmail.com>  (keep the outer quotes)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="<your-club-email@gmail.com>"
SMTP_PASS="<abcd efgh ijkl mnop>"
EMAIL_FROM="\"ARX IT Club\" <your-club-email@gmail.com>"

# Where to deliver the Presidential Admin's 2FA OTP codes
PRESIDENTIAL_ADMIN_EMAIL=<presidential-admin-email@gmail.com>

# Displayed in email subjects and templates
CLUB_NAME="ARX IT CLUB"

# ------------------------------------------------------------------------------
# 6. TELEGRAM BOT & CHANNEL
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<your-bot-token-from-BotFather>
TELEGRAM_BOT_USERNAME=ARXITCLUB_bot
TELEGRAM_CHANNEL_USERNAME=arxitclub
TELEGRAM_WEBHOOK_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
TELEGRAM_DELIVERY_MODE=polling

# ------------------------------------------------------------------------------
# 7. OPTIONAL SERVICES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
DETECTION_MODEL=gemini-2.5-flash

# ==============================================================================
# API ENDPOINT REFERENCE
# ==============================================================================
#
# 2FA LOGIN FLOW (all admin-tier & teacher accounts):
#   POST   /api/auth/admin-login          → { memberId, password }
#                                           Returns: { pendingUserId, maskedEmail }
#   POST   /api/auth/verify-otp           → { pendingUserId, otpCode }
#                                           Returns: { token, member }
#   POST   /api/auth/resend-otp           → { pendingUserId }
#
# PRESIDENTIAL ADMIN — STAFF MANAGEMENT (requires 2FA JWT):
#   POST   /api/auth/admin/create-staff   → { name, email, password, role, assignedCourseIds[] }
#   PATCH  /api/auth/admin/assign-course  → { staffMemberId, courseIds[] }
#   GET    /api/auth/admin/staff          → list all lower_admins & teachers
#
# SCOPED STUDENT DATA (requires 2FA JWT — results auto-filtered by role):
#   GET    /api/scoped/courses                        → courses visible to requester
#   GET    /api/scoped/students                       → students in requester's courses
#   GET    /api/scoped/students/:studentId            → single student (scoped)
#   GET    /api/scoped/courses/:courseId/students     → all students in a specific course
#
# ==============================================================================
